
<?xml version="1.0"?>
<ruleset name="WP Plugin Senior Pipeline">
  <description>PHPCS ruleset: WordPress Coding Standards + PHPCompatibilityWP</description>

  <config name="installed_paths" value="vendor/wp-coding-standards/wpcs"/>
  <!-- Adjust this to your plugin's minimum supported WordPress version -->
  <config name="minimum_supported_wp_version" value="6.6"/>

  <arg name="basepath" value="."/>
  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg value="p"/>

  <file>.</file>

  <exclude-pattern>vendor/*</exclude-pattern>
  <exclude-pattern>node_modules/*</exclude-pattern>
  <exclude-pattern>build/*</exclude-pattern>
  <exclude-pattern>dist/*</exclude-pattern>

  <!-- WordPress standards -->
  <rule ref="WordPress-Core"/>
  <rule ref="WordPress-Extra"/>
  <rule ref="WordPress-Docs"/>

  <!-- PHP compatibility: adjust testVersion to your supported range -->
  <rule ref="PHPCompatibilityWP">
    <properties>
      <property name="testVersion" value="7.4-"/>
    </properties>
  </rule>

  <!-- Allow short array syntax etc is covered by standards -->
</ruleset>
